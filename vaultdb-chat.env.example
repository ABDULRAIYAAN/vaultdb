# Copy this file to vaultdb-chat.env (which git ignores) and fill in what you use.
# Then chat.bat / vaultdb-chat picks these up automatically.

# Which providers to use (see: go run ./cmd/vaultdb-chat providers)
VAULTDB_EMBED=local
VAULTDB_LLM=none
# VAULTDB_MODEL=
# VAULTDB_EMBED_MODEL=

# API keys: only the ones for providers you use
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# VOYAGE_API_KEY=
# JINA_API_KEY=
